<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/pozadinaBoja"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivNagrada"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_league_gold"
        android:contentDescription="nagrada"
        android:scaleX="0"
        android:scaleY="0"
        android:alpha="0"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nagrada_cestitamo"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/zlatnaZvezde"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvNagradaNedelja"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvNagradaMesec"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvUkupno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/zlatnaZvezde"
        android:gravity="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnZatvori"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_zatvori"/>

</LinearLayout>
