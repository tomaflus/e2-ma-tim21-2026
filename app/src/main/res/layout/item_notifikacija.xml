<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical">

    <!-- Checkbox za selekciju (vidljiv samo u selekcijskom rezimu) -->
    <CheckBox
        android:id="@+id/cbSelektovana"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone"
        android:buttonTint="#FFFFFF"/>

    <!-- Ikona kanala -->
    <TextView
        android:id="@+id/tvIkona"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:text="🔔"
        android:textSize="22sp"
        android:gravity="center"
        android:layout_marginEnd="12dp"/>

    <!-- Sadržaj notifikacije -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNaslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Naslov notifikacije"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tvSadrzaj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sadržaj poruke..."
            android:textSize="13sp"
            android:textColor="#757575"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDatumVrijeme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="01. jan 2026, 12:00"
            android:textSize="11sp"
            android:textColor="#9E9E9E"/>

    </LinearLayout>

    <!-- Indikator nepročitano — bijela kružića -->
    <View
        android:id="@+id/viewNeprocitano"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_neprocitano_krug"
        android:layout_marginStart="8dp"
        android:visibility="visible"/>

</LinearLayout>
