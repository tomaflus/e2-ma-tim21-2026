<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvBodovi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bodovi: 0"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvTajmer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⏱ 2:00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="end"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asocijacije"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- 4 kolone sa po 4 skrivena polja -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <!-- Kolona 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="2dp">

                <Button
                    android:id="@+id/btnK1R1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK1R2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK1R3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK1R4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="4dp"/>

                <!-- Rješenje kolone 1 -->
                <Button
                    android:id="@+id/btnRez1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="14sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="@color/white"/>

            </LinearLayout>

            <!-- Kolona 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

                <Button
                    android:id="@+id/btnK2R1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK2R2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK2R3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK2R4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnRez2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="14sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="@color/white"/>

            </LinearLayout>

            <!-- Kolona 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

                <Button
                    android:id="@+id/btnK3R1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK3R2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK3R3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK3R4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnRez3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="14sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="@color/white"/>

            </LinearLayout>

            <!-- Kolona 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="2dp">

                <Button
                    android:id="@+id/btnK4R1"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK4R2"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK4R3"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="2dp"/>

                <Button
                    android:id="@+id/btnK4R4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="18sp"
                    android:backgroundTint="@color/black"
                    android:textColor="@color/white"
                    android:layout_marginBottom="4dp"/>

                <Button
                    android:id="@+id/btnRez4"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="?"
                    android:textSize="14sp"
                    android:backgroundTint="#1565C0"
                    android:textColor="@color/white"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Konačno rješenje -->
        <Button
            android:id="@+id/btnKonacnoRjesenje"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="KONAČNO RJEŠENJE: ?"
            android:textSize="16sp"
            android:backgroundTint="#B71C1C"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp"/>

        <!-- Unos odgovora -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Unesite odgovor"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOdgovor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnPogodi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pogodi"/>

    </LinearLayout>

</ScrollView>
