<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadinaBoja">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_dnevne_misije"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDatum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/textSekundarna"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Misija 1: Pobeda u partiji -->
        <LinearLayout
            android:id="@+id/rowMisija1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/headerBoja"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvStatus1"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="center"
                android:text="○"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/misija_pobeda"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3 ★"
                android:textColor="@color/zlatnaZvezde"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Misija 2: Poruka u četu -->
        <LinearLayout
            android:id="@+id/rowMisija2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/headerBoja"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvStatus2"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="center"
                android:text="○"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/misija_poruka_cet"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3 ★"
                android:textColor="@color/zlatnaZvezde"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Misija 3: Prijateljska partija -->
        <LinearLayout
            android:id="@+id/rowMisija3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/headerBoja"
            android:padding="14dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvStatus3"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="center"
                android:text="○"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/misija_prijateljska"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3 ★"
                android:textColor="@color/zlatnaZvezde"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Misija 4: Pobeda u turniru -->
        <LinearLayout
            android:id="@+id/rowMisija4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/headerBoja"
            android:padding="14dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStatus4"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="center"
                android:text="○"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/misija_turnir"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3 ★"
                android:textColor="@color/zlatnaZvezde"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Bonus red -->
        <LinearLayout
            android:id="@+id/rowBonus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/headerBoja"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStatusBonus"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:gravity="center"
                android:text="○"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/misija_bonus"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+3 ★ +2 🎟"
                android:textColor="@color/zlatnaZvezde"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
