<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pozadinaBoja">

    <!-- Zaglavlje sa info o partiji -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/headerBoja">

        <!-- Igrac 1 (lijevo) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvIgrac1Ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Igrac 1"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>

            <TextView
                android:id="@+id/tvIgrac1Bodovi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 bodova"
                android:textSize="12sp"
                android:textColor="#FFD700"/>

        </LinearLayout>

        <!-- Naziv igre (centar) -->
        <TextView
            android:id="@+id/tvIgra"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="Igra 1/6"
            android:textSize="13sp"
            android:textColor="#AAAACC"
            android:gravity="center"/>

        <!-- Igrac 2 (desno) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvIgrac2Ime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Igrac 2"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="end"/>

            <TextView
                android:id="@+id/tvIgrac2Bodovi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 bodova"
                android:textSize="12sp"
                android:textColor="#FFD700"
                android:gravity="end"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/dividerBoja"/>

    <!-- Kontejner za igre -->
    <FrameLayout
        android:id="@+id/gameContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>
