<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12122A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status + tajmer (jedan red) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#FFD700"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tvTajmer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱ 45s"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Skočko"
                android:textColor="#AAAAFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <!-- Pokušaj 1 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR1P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR1P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR1P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR1P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR1" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Pokušaj 2 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR2P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR2P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR2P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR2P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR2" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Pokušaj 3 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR3P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR3P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR3P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR3P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR3" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Pokušaj 4 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR4P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR4P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR4P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR4P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR4" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Pokušaj 5 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="4dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR5P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR5P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR5P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR5P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR5" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Pokušaj 6 -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR6P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR6P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR6P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR6P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#FFFFFF" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR6" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Linija razdvajanja -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#4444AA"
                android:layout_marginBottom="8dp"/>

            <!-- Red 7 — protivnikov pokušaj -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Protivnik (1 pokušaj):"
                android:textColor="#AAAACC"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR7P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR7P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR7P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR7P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <LinearLayout android:id="@+id/llFeedbackR7" android:layout_width="64dp" android:layout_height="52dp" android:orientation="vertical" android:gravity="center"/>
            </LinearLayout>

            <!-- Red 8 — tačno rešenje -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tačno rešenje:"
                android:textColor="#AAAACC"
                android:textSize="13sp"
                android:layout_marginBottom="2dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp" android:gravity="center_vertical">
                <Button android:id="@+id/btnSlotR8P1" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR8P2" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR8P3" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSlotR8P4" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="" android:textColor="#AAAACC" android:textSize="20sp" android:padding="0dp" android:background="@drawable/bg_slot_skocko" android:enabled="false" android:layout_margin="3dp"/>
                <View android:layout_width="64dp" android:layout_height="52dp"/>
            </LinearLayout>

            <!-- Odabir simbola -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odaberi simbol:"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <Button android:id="@+id/btnSimbol1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="😀" android:textSize="24sp" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSimbol2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🟥" android:textSize="24sp" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSimbol3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔵" android:textSize="24sp" android:layout_margin="3dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button android:id="@+id/btnSimbol4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="❤️" android:textSize="24sp" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSimbol5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="🔺" android:textSize="24sp" android:layout_margin="3dp"/>
                <Button android:id="@+id/btnSimbol6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="⭐" android:textSize="24sp" android:layout_margin="3dp"/>

            </LinearLayout>

            <Button
                android:id="@+id/btnPotvrdaPokusaja"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Potvrdi pokušaj"
                android:textSize="16sp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Overlay dok protivnik igra -->
    <FrameLayout
        android:id="@+id/overlayProtivnik"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="false"
        android:focusable="false"/>

</FrameLayout>
