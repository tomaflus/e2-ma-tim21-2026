<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="@color/headerBoja">

    <TextView
        android:id="@+id/tvPozicija"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="@color/textSekundarna"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/ivLiga"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="liga"/>

    <TextView
        android:id="@+id/tvIme"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/white"
        android:textSize="15sp"/>

    <TextView
        android:id="@+id/tvZvezde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/zlatnaZvezde"
        android:textSize="14sp"
        android:textStyle="bold"/>

</LinearLayout>
