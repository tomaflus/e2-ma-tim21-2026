<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pozadinaBoja">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Notifikacije"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:padding="16dp"/>

    <!-- Filter chipovi -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFilter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterSve"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sve"
            android:checked="true"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterNeprocitane"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nepročitane"/>

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFilterProcitane"
            style="@style/Widget.MaterialComponents.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pročitane"/>

    </com.google.android.material.chip.ChipGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/dividerBoja"/>

    <!-- Traka za selekciju (vidljiva samo u selekcijskom rezimu) -->
    <LinearLayout
        android:id="@+id/llSelekcijaToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#22FFFFFF"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIzaberiSve"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Izaberi sve"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:backgroundTint="#1565C0"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnObrisiSelektovane"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Obriši"
            android:textSize="13sp"
            android:drawableStart="@drawable/ic_trash"
            android:drawablePadding="4dp"
            app:cornerRadius="8dp"
            app:backgroundTint="#C62828"/>

    </LinearLayout>

    <!-- Lista notifikacija -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifikacije"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

</LinearLayout>
