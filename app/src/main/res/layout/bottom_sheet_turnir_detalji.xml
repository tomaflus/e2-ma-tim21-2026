<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/pozadinaBoja"
    android:paddingBottom="32dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#44FFFFFF" />

    <TextView
        android:id="@+id/tvDetaljiNaziv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="8dp"
        android:textColor="#FFD700"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingBottom="16dp"
        android:text="Igrači:"
        android:textColor="#AAFFFFFF"
        android:textSize="13sp" />

    <!-- Dinamički popunjena lista igrača -->
    <LinearLayout
        android:id="@+id/llDetaljiIgraci"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingBottom="24dp" />

    <!-- Ucestvuj -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUcestvuj"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="Učestvuj!  Cena: 3 tokena"
        android:textSize="16sp"
        android:textStyle="bold"
        android:drawableStart="@drawable/ic_token"
        android:drawablePadding="8dp"
        app:backgroundTint="#4CAF50"
        app:cornerRadius="28dp" />

    <!-- Napusti -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNapusti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:text="Napusti turnir"
        app:backgroundTint="@color/crvenaDugme"
        app:cornerRadius="8dp" />

    <!-- Obriši (samo vlasnik) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnObrisi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:text="Obriši turnir"
        app:backgroundTint="#B71C1C"
        app:cornerRadius="8dp" />

</LinearLayout>
