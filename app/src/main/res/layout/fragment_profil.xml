<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadinaBoja">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:padding="4dp"
            android:background="@drawable/circle_frame"
            android:src="@drawable/ic_profile"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
            app:layout_constraintStart_toStartOf="@id/ivAvatar"
            app:layout_constraintEnd_toEndOf="@id/ivAvatar" />

        <Button
            android:id="@+id/btnChangeAvatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_avatar"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvKorisnickoImeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_username"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnChangeAvatar"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvKorisnickoIme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Korisnik123"
            android:textColor="@color/textSekundarna"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/tvKorisnickoImeLabel"
            app:layout_constraintStart_toEndOf="@id/tvKorisnickoImeLabel" />

        <TextView
            android:id="@+id/tvEmailLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_email"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvKorisnickoImeLabel"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="korisnik@example.com"
            android:textColor="@color/textSekundarna"
            android:layout_marginStart="8dp"
            app:layout_constraintTop_toTopOf="@id/tvEmailLabel"
            app:layout_constraintStart_toEndOf="@id/tvEmailLabel" />

        <LinearLayout
            android:id="@+id/llStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvEmail">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_token" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_tokens"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:id="@+id/tvTokeni"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="10"
                    android:textColor="@color/textSekundarna"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_stars"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:id="@+id/tvZvezde"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="150"
                    android:textColor="@color/textSekundarna"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_league" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_league"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp" />
                <TextView
                    android:id="@+id/tvLiga"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Zlatna"
                    android:textColor="@color/textSekundarna"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_region"
                    android:textStyle="bold"
                    android:textColor="@color/white" />
                <TextView
                    android:id="@+id/tvRegion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Srbija"
                    android:textColor="@color/textSekundarna"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvQrLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_qr_code"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llStats"
            app:layout_constraintStart_toStartOf="parent" />

        <FrameLayout
            android:id="@+id/flQrPlaceholder"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@color/headerBoja"
            app:layout_constraintTop_toBottomOf="@id/tvQrLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:src="@drawable/qr_placeholder" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR CODE"
                android:layout_gravity="center"
                android:textColor="@color/textSekundarna"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/llButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/flQrPlaceholder">

            <Button
                android:id="@+id/btnFriends"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_friends"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnRegions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_regions"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnLeagues"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lige"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatistikaTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_statistics"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/llButtons"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvOdigranoIgaraVrednost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Odigrano igara: 0"
            android:textColor="@color/textSekundarna"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvStatistikaTitle"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvProsecniBodovi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Prosečni bodovi: 0.0"
            android:textColor="@color/textSekundarna"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvOdigranoIgaraVrednost"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvPobedaVrednost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Pobeda: 0 (0%)"
            android:textColor="@color/textSekundarna"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvProsecniBodovi"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTacniKviza"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Ko zna zna tačnost: 0%"
            android:textColor="@color/textSekundarna"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvPobedaVrednost"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvPocenatSpojnica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Spojnice uspešnost: 0%"
            android:textColor="@color/textSekundarna"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvTacniKviza"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_logout"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/crvenaDugme"
            app:layout_constraintTop_toBottomOf="@id/tvPocenatSpojnica"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>