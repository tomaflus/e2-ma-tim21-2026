<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dobrodošli!"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvKorisnik"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="18sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnIgraj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Igraj!"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnPromjeniLozinku"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Promijeni lozinku"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnKorakPoKorak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEST - Korak po korak"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnMojBroj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TEST - Moj broj"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnOdjava"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Odjavi se"/>

</LinearLayout>