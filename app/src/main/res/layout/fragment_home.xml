<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pozadinaBoja">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dobrodošli!"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvKorisnik"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="14sp"
                android:textColor="@color/textSekundarna"
                android:gravity="center"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvTokeniZvezde"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tokeni: - | Zvezde: -"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/zlatnaZvezde"
                android:gravity="center"
                android:layout_marginBottom="32dp"/>

            <Button
                android:id="@+id/btnIgraj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Igraj!"
                android:textSize="18sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnPromjeniLozinku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Promijeni lozinku"
                android:layout_marginBottom="8dp"/>

            <!-- Student 2 Igre -->
            <Button
                android:id="@+id/btnProfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_profile"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnKoZnaZna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_ko_zna_zna"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnSpojnice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_spojnice"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnNotifikacije"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notifikacije"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnRangLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_rang_lista"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnOdjava"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Odjavi se"
                android:backgroundTint="@color/crvenaDugme"/>

        </LinearLayout>
    </ScrollView>

    <!-- Chat FAB dugme u donjem desnom uglu -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnCet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_dialog_email"
        android:contentDescription="Chat"
        app:tint="@color/white"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnIzazov"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_compass"
        android:contentDescription="Izazov"
        app:tint="@color/white"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>