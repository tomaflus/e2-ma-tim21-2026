<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pozadinaBoja"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_rang_lista"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnNedeljna"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_nedeljna"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnMesecna"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/btn_mesecna"
            android:layout_marginStart="4dp"
            android:alpha="0.5"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvOpseg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textSekundarna"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRangLista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- TEST: ukloniti prije produkcije -->
    <Button
        android:id="@+id/btnTestSimulacija"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_test_simulacija"
        android:backgroundTint="@color/crvenaDugme"
        android:layout_marginTop="8dp"/>

</LinearLayout>
